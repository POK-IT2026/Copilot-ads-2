# ── Meta Ads ─────────────────────────────────────────────────────────────
# Token de acceso de sistema/usuario con permisos ads_read
META_ACCESS_TOKEN=
# IDs de cuentas publicitarias separadas por coma (con o sin prefijo act_)
META_AD_ACCOUNT_IDS=act_1234567890
# Versión de la Graph API
META_API_VERSION=v23.0

# ── Google Ads ───────────────────────────────────────────────────────────
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# ID de la cuenta MCC (opcional, sin guiones)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# IDs de cliente separados por coma (sin guiones)
GOOGLE_ADS_CUSTOMER_IDS=1234567890
GOOGLE_ADS_API_VERSION=v20

# ── IA (opcional, recomendaciones con Claude) ────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ── Base de datos ────────────────────────────────────────────────────────
# Ruta del archivo SQLite (por defecto db/campaign_copilot.db)
DATABASE_PATH=
