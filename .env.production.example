# Copia este archivo a .env.production para usarlo con docker-compose.
# Todos los tokens viven SOLO aquí — nunca en el código.

# ── Meta Ads ─────────────────────────────────────────────────────────────
META_ACCESS_TOKEN=
META_AD_ACCOUNT_IDS=act_1234567890
META_API_VERSION=v23.0

# ── Google Ads ───────────────────────────────────────────────────────────
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_IDS=1234567890
GOOGLE_ADS_API_VERSION=v20

# ── IA (opcional) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ── Base de datos (dentro del contenedor; se monta como volumen) ─────────
DATABASE_PATH=/app/db/campaign_copilot.db

# ── Sync automático (opcional) ───────────────────────────────────────────
AUTO_SYNC_INTERVAL_MINUTES=60
AUTO_SYNC_WINDOW_DAYS=30
AUTO_SYNC_DISABLED=
